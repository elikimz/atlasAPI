# Gmail SMTP with STARTTLS on port 587. Use an app password or OAuth-enabled setup.
APPSETTING_SMTP_SERVER=smtp.gmail.com
APPSETTING_SMTP_PORT=587
APPSETTING_SMTP_USERNAME=your-gmail-account@gmail.com
APPSETTING_EMAIL_SENDER_NAME=adpulseAI
APPSETTING_EMAIL_SENDER=support@adpulseaiglobaltech.site
APPSETTING_EMAIL_APP_PASSWORD=replace-with-secret-store-reference-or-local-secret
